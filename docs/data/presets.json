[{"id":"golden_cross","group":"Technical","name":"Golden Cross (50/200) in last 5 days","expr":"bars_since(cross_above(sma_50, sma_200)) <= 5 and liquid == 1","hits":["CYCL","MANDU","SHPC"]},{"id":"death_cross","group":"Technical","name":"Death Cross (50/200) in last 5 days","expr":"bars_since(cross_below(sma_50, sma_200)) <= 5","hits":["NHPC"]},{"id":"breakout_52w","group":"Technical","name":"52-week high breakout on volume","expr":"close > hh_250 and vol_ratio > 1.5 and liquid == 1","hits":[]},{"id":"breakout_55","group":"Technical","name":"55-day breakout (Turtle) with 2\u00d7 volume","expr":"close > hh_55 and vol_ratio > 2 and chg_pct > 0.02 and liquid == 1","hits":["SGHC","SMH"]},{"id":"pullback_uptrend","group":"Technical","name":"Pullback in uptrend (RSI-14 < 40 above 200-DMA)","expr":"close > sma_200 and ema_50 > sma_200 and rsi_14 < 40","hits":[]},{"id":"rsi2_oversold","group":"Technical","name":"RSI-2 oversold in uptrend","expr":"rsi_2 < 10 and close > sma_200 and liquid == 1","hits":["CZBIL","HBL","SCB","SHIVM"]},{"id":"macd_bull","group":"Technical","name":"MACD bullish crossover below zero","expr":"cross_above(macd, macd_signal) and macd < 0","hits":["NLG","SIFC"]},{"id":"supertrend_flip","group":"Technical","name":"Supertrend flipped bullish","expr":"st_dir > 0 and shift(st_dir, 1) < 0","hits":["SPC"]},{"id":"volume_spike","group":"Technical","name":"Accumulation: volume spike on up day","expr":"vol_ratio > 2.5 and chg_pct > 0.02 and close > open","hits":["AHL","PPCL","SHLB","SPC"]},{"id":"bb_squeeze","group":"Technical","name":"Bollinger squeeze (volatility at 6-month low)","expr":"bb_width < lowest(bb_width, 120) * 1.1 and liquid == 1","hits":["AKJCL","BEDC","BHPL","BJHL","CHDC","CORBL","DHEL","DOLTI","ECL","FMDBL","HIDCL","JOSHI","KHPL","MEHL","NABBC","NICL","NICLBSL","NIL","PFL","PRIN","PURE","RAWA","RIDI","RSDC","RSML","SABBL","SAIL","SLBBL","SSHL","UAIL","ULHC","UPPER","VLUCL"]},{"id":"strong_trend","group":"Technical","name":"Strong uptrend (ADX